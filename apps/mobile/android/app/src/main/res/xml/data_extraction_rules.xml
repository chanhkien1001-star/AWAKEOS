<?xml version="1.0" encoding="utf-8"?>
<!-- Local-first (I-09): nothing is backed up off the device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
