{
  "name": "awakeos",
  "version": "0.0.1",
  "private": true,
  "description": "React Native host app for Human Agency OS. Standalone project — not part of the repo npm workspace.",
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "build:aab": "cd android && ./gradlew bundleRelease",
    "build:apk": "cd android && ./gradlew assembleRelease",
    "clean": "cd android && ./gradlew clean"
  },
  "dependencies": {
    "@awake-os/core": "file:../../packages/core",
    "@awake-os/app": "file:../../packages/app",
    "react": "18.3.1",
    "react-native": "0.75.4",
    "react-native-keychain": "^9.2.2",
    "react-native-mmkv": "^2.12.2",
    "react-native-quick-crypto": "^0.7.11"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native/babel-preset": "0.75.4",
    "@react-native/metro-config": "0.75.4",
    "@react-native/typescript-config": "0.75.4",
    "@types/react": "^18.3.3",
    "typescript": "5.5.4"
  },
  "engines": {
    "node": ">=18"
  }
}
